# SQLite persistent file. Relative paths resolve against the project root.
# Compose uses /app/data/archive.sqlite on its persistent archive-data volume.
DATABASE_PATH=./data/archive.sqlite

# Optional for a new database: bootstrap generates and persists a random secret.
# Existing databases must keep their original BETTER_AUTH_SECRET; never rotate by accident.
BETTER_AUTH_SECRET=

# Exact external origin, without a path. Local development may use HTTP loopback.
# For either production deployment behind an external reverse proxy, use its public HTTPS origin.
# This origin is also the only trusted authentication origin. No wildcard/proxy trust.
BETTER_AUTH_URL=http://localhost:3000

# Local is the default in development and production. Set r2 explicitly to use Cloudflare.
# Explicit local is supported for self-hosted/local production testing; never auto-fallback.
STORAGE_DRIVER=local
# Optional: defaults to storage/ alongside DATABASE_PATH. Never place under public/.
LOCAL_STORAGE_PATH=

# Used once if no administrator exists. Empty password generates a protected random one.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrator

# Required only for STORAGE_DRIVER=r2. Server-only, never NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=campus-archive-private
R2_PUBLIC_BUCKET=campus-archive-public
# Exact HTTPS origin for the public bucket's custom domain, without a path.
R2_PUBLIC_BASE_URL=
R2_AUTO_CREATE_BUCKETS=false

# Public Turnstile site key, read by the dynamic submit page at runtime.
# The secret is server-only and never uses NEXT_PUBLIC_. Use production keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC key for anonymous submission rate-limit buckets. Local development falls
# back to BETTER_AUTH_SECRET when this is empty; set a separate random secret in production.
RATE_LIMIT_SECRET=
# Leave empty unless an authenticated reverse proxy strips and rewrites this header.
TRUSTED_PROXY_IP_HEADER=

# Optional server-only Cloudflare Zone cache purge credentials. Without these,
# database visibility is updated and R2 objects are deleted, but old CDN URLs
# may remain cached until their normal expiry.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
