# SQLite persistent file. Relative paths resolve against the project root.
DATABASE_PATH=./data/archive.sqlite

# Required at application startup (not build). Generate with pnpm auth:secret.
# Use a random secret >=32 characters; never commit the real value.
BETTER_AUTH_SECRET=

# Exact external origin, without a path. Local development may use HTTP loopback.
# For Docker + Cloudflare Tunnel set the actual public HTTPS origin.
# This origin is also the only trusted authentication origin. No wildcard/proxy trust.
BETTER_AUTH_URL=http://localhost:3000

# Reserved for future stages; not required for authentication or local development.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
