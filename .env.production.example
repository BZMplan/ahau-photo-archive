# Copy to .env.production (ignored by Git), then set real values.
# Compose uses DATABASE_PATH=/app/data/archive.sqlite on a persistent volume.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SECRET=
TRUSTED_PROXY_IP_HEADER=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
# Optional image tag for a reviewed application rollback.
APP_IMAGE=ahau-photo-archive-app:latest
