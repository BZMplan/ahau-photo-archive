{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./.output/migrations",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "plugins": []
  },
  "include": [
    "scripts/migrate.ts",
    "src/server/db/connection.ts",
    "src/server/db/path.ts",
    "src/server/db/schema.ts"
  ],
  "exclude": ["node_modules"]
}
