{
  "name": "ahau-photo-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:images",
    "db:compile": "tsc -p tsconfig.migrations.json",
    "admin:init": "tsx scripts/admin-init.ts",
    "auth:secret": "auth secret",
    "auth:generate": "auth generate --config src/server/auth/cli.ts --output src/server/db/auth-schema.ts --yes",
    "auth:check": "auth check schema --config src/server/auth/cli.ts",
    "test:auth-flow": "tsx --test tests/http/*.test.ts",
    "test:images": "vitest run",
    "storage:check": "tsx --conditions=react-server scripts/check-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@next/env": "^16.4.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <27"
  }
}
